def upperAtom00 (a t z : ℝ) : ℝ := (((((((((2 : ℝ)*(a^6))*((t^4)*(z^2)))+(((-2 : ℝ)*(a^6))*((t^4)*z)))+((((-6 : ℝ)*(a^6))*((t^3)*(z^2)))+(((6 : ℝ)*(a^6))*((t^3)*z))))+(((((6 : ℝ)*(a^6))*((t^2)*(z^2)))+(((-6 : ℝ)*(a^6))*((t^2)*z)))+((((-2 : ℝ)*(a^6))*(t*(z^2)))+(((2 : ℝ)*(a^6))*(t*z)))))+((((((-4 : ℝ)*(a^5))*((t^4)*(z^2)))+(((5 : ℝ)*(a^5))*((t^4)*z)))+(((1 : ℝ)*((a^5)*(t^4)))+(((7 : ℝ)*(a^5))*((t^3)*(z^2)))))+(((((-7 : ℝ)*(a^5))*((t^3)*z))+((-4 : ℝ)*((a^5)*(t^3))))+((((-1 : ℝ)*(a^5))*((t^2)*(z^2)))+(((-3 : ℝ)*(a^5))*((t^2)*z))))))+((((((6 : ℝ)*((a^5)*(t^2)))+(((-3 : ℝ)*(a^5))*(t*(z^2))))+((((7 : ℝ)*(a^5))*(t*z))+((-4 : ℝ)*((a^5)*t))))+((((1 : ℝ)*((a^5)*(z^2)))+((-2 : ℝ)*((a^5)*z)))+(((1 : ℝ)*(a^5))+(((2 : ℝ)*(a^4))*((t^4)*(z^2))))))+((((((-5 : ℝ)*(a^4))*((t^4)*z))+((-1 : ℝ)*((a^4)*(t^4))))+((((2 : ℝ)*(a^4))*((t^3)*(z^2)))+(((1 : ℝ)*(a^4))*((t^3)*z))))+((((1 : ℝ)*((a^4)*(t^3)))+(((-6 : ℝ)*(a^4))*((t^2)*(z^2))))+((((3 : ℝ)*(a^4))*((t^2)*z))+((3 : ℝ)*((a^4)*(t^2))))))))+((((((((5 : ℝ)*(a^4))*(t*z))+((-5 : ℝ)*((a^4)*t)))+(((2 : ℝ)*((a^4)*(z^2)))+((-4 : ℝ)*((a^4)*z))))+((((2 : ℝ)*(a^4))+(((3 : ℝ)*(a^3))*((t^4)*z)))+(((-2 : ℝ)*((a^3)*(t^4)))+(((-3 : ℝ)*(a^3))*((t^3)*(z^2))))))+(((((8 : ℝ)*((a^3)*(t^3)))+(((1 : ℝ)*(a^3))*((t^2)*(z^2))))+((((4 : ℝ)*(a^3))*((t^2)*z))+((-9 : ℝ)*((a^3)*(t^2)))))+(((((1 : ℝ)*(a^3))*(t*(z^2)))+(((-3 : ℝ)*(a^3))*(t*z)))+(((2 : ℝ)*((a^3)*t))+((1 : ℝ)*((a^3)*(z^2)))))))+((((((-2 : ℝ)*((a^3)*z))+((1 : ℝ)*(a^3)))+((((-1 : ℝ)*(a^2))*((t^4)*z))+((2 : ℝ)*((a^2)*(t^4)))))+(((((-3 : ℝ)*(a^2))*((t^3)*z))+((-2 : ℝ)*((a^2)*(t^3))))+((((3 : ℝ)*(a^2))*((t^2)*z))+((-3 : ℝ)*((a^2)*(t^2))))))+((((((-3 : ℝ)*(a^2))*(t*z))+((3 : ℝ)*((a^2)*t)))+(((1 : ℝ)*(a*(t^4)))+(((3 : ℝ)*a)*((t^3)*z))))+((((-4 : ℝ)*(a*(t^3)))+(((-1 : ℝ)*a)*((t^2)*z)))+(((3 : ℝ)*(a*(t^2)))+(((-1 : ℝ)*(t^4))+((1 : ℝ)*(t^3)))))))))

theorem upperNum00_map (a t z : ℝ) :
    upperNum00 a (a+(1-a)*t) z=(1-a)^2*upperAtom00 a t z := by
  unfold upperNum00 upperAtom00
  ring

end LeanVerification.PositiveDCompletion
