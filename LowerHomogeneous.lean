import LeanVerification.PositiveDCompletion.LowerCoordinates

noncomputable section
namespace LeanVerification.PositiveDCompletion
set_option maxHeartbeats 16000000
set_option maxRecDepth 40000

theorem lower_homogeneous_2 (a f d0 w u c0 c1 c2 : ℝ) (hf : f≠0) (hd : d0≠0) :
    (f*d0)^(2 : ℕ)*((c0*((a*d0+w*u)/(f*d0))^(0 : ℕ)+(c1*((a*d0+w*u)/(f*d0))^(1 : ℕ)+c2*((a*d0+w*u)/(f*d0))^(2 : ℕ))))=(d0^(2 : ℕ)*w^(0 : ℕ)*(((1 : ℝ)*c0*a^(0 : ℕ)*f^(2 : ℕ)+((1 : ℝ)*c1*a^(1 : ℕ)*f^(1 : ℕ)+(1 : ℝ)*c2*a^(2 : ℕ)*f^(0 : ℕ))))*u^(0 : ℕ)+(d0^(1 : ℕ)*w^(1 : ℕ)*(((1 : ℝ)*c1*a^(0 : ℕ)*f^(1 : ℕ)+(2 : ℝ)*c2*a^(1 : ℕ)*f^(0 : ℕ)))*u^(1 : ℕ)+d0^(0 : ℕ)*w^(2 : ℕ)*((1 : ℝ)*c2*a^(0 : ℕ)*f^(0 : ℕ))*u^(2 : ℕ))) := by
  field_simp (disch := simp [hf,hd]) [hf,hd]
  ring

theorem lower_homogeneous_3 (a f d0 w u c0 c1 c2 c3 : ℝ) (hf : f≠0) (hd : d0≠0) :
    (f*d0)^(3 : ℕ)*(((c0*((a*d0+w*u)/(f*d0))^(0 : ℕ)+c1*((a*d0+w*u)/(f*d0))^(1 : ℕ))+(c2*((a*d0+w*u)/(f*d0))^(2 : ℕ)+c3*((a*d0+w*u)/(f*d0))^(3 : ℕ))))=((d0^(3 : ℕ)*w^(0 : ℕ)*((((1 : ℝ)*c0*a^(0 : ℕ)*f^(3 : ℕ)+(1 : ℝ)*c1*a^(1 : ℕ)*f^(2 : ℕ))+((1 : ℝ)*c2*a^(2 : ℕ)*f^(1 : ℕ)+(1 : ℝ)*c3*a^(3 : ℕ)*f^(0 : ℕ))))*u^(0 : ℕ)+d0^(2 : ℕ)*w^(1 : ℕ)*(((1 : ℝ)*c1*a^(0 : ℕ)*f^(2 : ℕ)+((2 : ℝ)*c2*a^(1 : ℕ)*f^(1 : ℕ)+(3 : ℝ)*c3*a^(2 : ℕ)*f^(0 : ℕ))))*u^(1 : ℕ))+(d0^(1 : ℕ)*w^(2 : ℕ)*(((1 : ℝ)*c2*a^(0 : ℕ)*f^(1 : ℕ)+(3 : ℝ)*c3*a^(1 : ℕ)*f^(0 : ℕ)))*u^(2 : ℕ)+d0^(0 : ℕ)*w^(3 : ℕ)*((1 : ℝ)*c3*a^(0 : ℕ)*f^(0 : ℕ))*u^(3 : ℕ))) := by
  field_simp (disch := simp [hf,hd]) [hf,hd]
  ring

theorem lower_homogeneous_4 (a f d0 w u c0 c1 c2 c3 c4 : ℝ) (hf : f≠0) (hd : d0≠0) :
    (f*d0)^(4 : ℕ)*(((c0*((a*d0+w*u)/(f*d0))^(0 : ℕ)+c1*((a*d0+w*u)/(f*d0))^(1 : ℕ))+(c2*((a*d0+w*u)/(f*d0))^(2 : ℕ)+(c3*((a*d0+w*u)/(f*d0))^(3 : ℕ)+c4*((a*d0+w*u)/(f*d0))^(4 : ℕ)))))=((d0^(4 : ℕ)*w^(0 : ℕ)*((((1 : ℝ)*c0*a^(0 : ℕ)*f^(4 : ℕ)+(1 : ℝ)*c1*a^(1 : ℕ)*f^(3 : ℕ))+((1 : ℝ)*c2*a^(2 : ℕ)*f^(2 : ℕ)+((1 : ℝ)*c3*a^(3 : ℕ)*f^(1 : ℕ)+(1 : ℝ)*c4*a^(4 : ℕ)*f^(0 : ℕ)))))*u^(0 : ℕ)+d0^(3 : ℕ)*w^(1 : ℕ)*((((1 : ℝ)*c1*a^(0 : ℕ)*f^(3 : ℕ)+(2 : ℝ)*c2*a^(1 : ℕ)*f^(2 : ℕ))+((3 : ℝ)*c3*a^(2 : ℕ)*f^(1 : ℕ)+(4 : ℝ)*c4*a^(3 : ℕ)*f^(0 : ℕ))))*u^(1 : ℕ))+(d0^(2 : ℕ)*w^(2 : ℕ)*(((1 : ℝ)*c2*a^(0 : ℕ)*f^(2 : ℕ)+((3 : ℝ)*c3*a^(1 : ℕ)*f^(1 : ℕ)+(6 : ℝ)*c4*a^(2 : ℕ)*f^(0 : ℕ))))*u^(2 : ℕ)+(d0^(1 : ℕ)*w^(3 : ℕ)*(((1 : ℝ)*c3*a^(0 : ℕ)*f^(1 : ℕ)+(4 : ℝ)*c4*a^(1 : ℕ)*f^(0 : ℕ)))*u^(3 : ℕ)+d0^(0 : ℕ)*w^(4 : ℕ)*((1 : ℝ)*c4*a^(0 : ℕ)*f^(0 : ℕ))*u^(4 : ℕ)))) := by
  field_simp (disch := simp [hf,hd]) [hf,hd]
  ring

theorem lower_homogeneous_6 (a f d0 w u c0 c1 c2 c3 c4 c5 c6 : ℝ) (hf : f≠0) (hd : d0≠0) :
    (f*d0)^(6 : ℕ)*(((c0*((a*d0+w*u)/(f*d0))^(0 : ℕ)+(c1*((a*d0+w*u)/(f*d0))^(1 : ℕ)+c2*((a*d0+w*u)/(f*d0))^(2 : ℕ)))+((c3*((a*d0+w*u)/(f*d0))^(3 : ℕ)+c4*((a*d0+w*u)/(f*d0))^(4 : ℕ))+(c5*((a*d0+w*u)/(f*d0))^(5 : ℕ)+c6*((a*d0+w*u)/(f*d0))^(6 : ℕ)))))=((d0^(6 : ℕ)*w^(0 : ℕ)*((((1 : ℝ)*c0*a^(0 : ℕ)*f^(6 : ℕ)+((1 : ℝ)*c1*a^(1 : ℕ)*f^(5 : ℕ)+(1 : ℝ)*c2*a^(2 : ℕ)*f^(4 : ℕ)))+(((1 : ℝ)*c3*a^(3 : ℕ)*f^(3 : ℕ)+(1 : ℝ)*c4*a^(4 : ℕ)*f^(2 : ℕ))+((1 : ℝ)*c5*a^(5 : ℕ)*f^(1 : ℕ)+(1 : ℝ)*c6*a^(6 : ℕ)*f^(0 : ℕ)))))*u^(0 : ℕ)+(d0^(5 : ℕ)*w^(1 : ℕ)*((((1 : ℝ)*c1*a^(0 : ℕ)*f^(5 : ℕ)+((2 : ℝ)*c2*a^(1 : ℕ)*f^(4 : ℕ)+(3 : ℝ)*c3*a^(2 : ℕ)*f^(3 : ℕ)))+((4 : ℝ)*c4*a^(3 : ℕ)*f^(2 : ℕ)+((5 : ℝ)*c5*a^(4 : ℕ)*f^(1 : ℕ)+(6 : ℝ)*c6*a^(5 : ℕ)*f^(0 : ℕ)))))*u^(1 : ℕ)+d0^(4 : ℕ)*w^(2 : ℕ)*((((1 : ℝ)*c2*a^(0 : ℕ)*f^(4 : ℕ)+(3 : ℝ)*c3*a^(1 : ℕ)*f^(3 : ℕ))+((6 : ℝ)*c4*a^(2 : ℕ)*f^(2 : ℕ)+((10 : ℝ)*c5*a^(3 : ℕ)*f^(1 : ℕ)+(15 : ℝ)*c6*a^(4 : ℕ)*f^(0 : ℕ)))))*u^(2 : ℕ)))+((d0^(3 : ℕ)*w^(3 : ℕ)*((((1 : ℝ)*c3*a^(0 : ℕ)*f^(3 : ℕ)+(4 : ℝ)*c4*a^(1 : ℕ)*f^(2 : ℕ))+((10 : ℝ)*c5*a^(2 : ℕ)*f^(1 : ℕ)+(20 : ℝ)*c6*a^(3 : ℕ)*f^(0 : ℕ))))*u^(3 : ℕ)+d0^(2 : ℕ)*w^(4 : ℕ)*(((1 : ℝ)*c4*a^(0 : ℕ)*f^(2 : ℕ)+((5 : ℝ)*c5*a^(1 : ℕ)*f^(1 : ℕ)+(15 : ℝ)*c6*a^(2 : ℕ)*f^(0 : ℕ))))*u^(4 : ℕ))+(d0^(1 : ℕ)*w^(5 : ℕ)*(((1 : ℝ)*c5*a^(0 : ℕ)*f^(1 : ℕ)+(6 : ℝ)*c6*a^(1 : ℕ)*f^(0 : ℕ)))*u^(5 : ℕ)+d0^(0 : ℕ)*w^(6 : ℕ)*((1 : ℝ)*c6*a^(0 : ℕ)*f^(0 : ℕ))*u^(6 : ℕ)))) := by
  field_simp (disch := simp [hf,hd]) [hf,hd]
  ring

end LeanVerification.PositiveDCompletion
