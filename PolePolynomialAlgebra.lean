import LeanVerification.PositiveDCompletion.PolynomialComparison

noncomputable section
namespace LeanVerification.PositiveDCompletion
set_option maxHeartbeats 12000000
set_option maxRecDepth 50000

theorem inverse_homogeneous_4 (m c w q0 q1 q2 q3 q4 : ℝ) :
    c^4*(((q0*w^0+q1*w^1)+(q2*w^2+(q3*w^3+q4*w^4))))=((((((1 : ℝ)*(-1 : ℝ)^0*m^0*c^4*q0+(1 : ℝ)*(-1 : ℝ)^1*m^1*c^3*q1)+((1 : ℝ)*(-1 : ℝ)^2*m^2*c^2*q2+((1 : ℝ)*(-1 : ℝ)^3*m^3*c^1*q3+(1 : ℝ)*(-1 : ℝ)^4*m^4*c^0*q4))))*(-m-c*w)^0+((((1 : ℝ)*(-1 : ℝ)^1*m^0*c^3*q1+(2 : ℝ)*(-1 : ℝ)^2*m^1*c^2*q2)+((3 : ℝ)*(-1 : ℝ)^3*m^2*c^1*q3+(4 : ℝ)*(-1 : ℝ)^4*m^3*c^0*q4)))*(-m-c*w)^1)+((((1 : ℝ)*(-1 : ℝ)^2*m^0*c^2*q2+((3 : ℝ)*(-1 : ℝ)^3*m^1*c^1*q3+(6 : ℝ)*(-1 : ℝ)^4*m^2*c^0*q4)))*(-m-c*w)^2+((((1 : ℝ)*(-1 : ℝ)^3*m^0*c^1*q3+(4 : ℝ)*(-1 : ℝ)^4*m^1*c^0*q4))*(-m-c*w)^3+((1 : ℝ)*(-1 : ℝ)^4*m^0*c^0*q4)*(-m-c*w)^4))) := by ring

theorem inverse_homogeneous_6 (m c w q0 q1 q2 q3 q4 q5 q6 : ℝ) :
    c^6*(((q0*w^0+(q1*w^1+q2*w^2))+((q3*w^3+q4*w^4)+(q5*w^5+q6*w^6))))=((((((1 : ℝ)*(-1 : ℝ)^0*m^0*c^6*q0+((1 : ℝ)*(-1 : ℝ)^1*m^1*c^5*q1+(1 : ℝ)*(-1 : ℝ)^2*m^2*c^4*q2))+(((1 : ℝ)*(-1 : ℝ)^3*m^3*c^3*q3+(1 : ℝ)*(-1 : ℝ)^4*m^4*c^2*q4)+((1 : ℝ)*(-1 : ℝ)^5*m^5*c^1*q5+(1 : ℝ)*(-1 : ℝ)^6*m^6*c^0*q6))))*(-m-c*w)^0+(((((1 : ℝ)*(-1 : ℝ)^1*m^0*c^5*q1+((2 : ℝ)*(-1 : ℝ)^2*m^1*c^4*q2+(3 : ℝ)*(-1 : ℝ)^3*m^2*c^3*q3))+((4 : ℝ)*(-1 : ℝ)^4*m^3*c^2*q4+((5 : ℝ)*(-1 : ℝ)^5*m^4*c^1*q5+(6 : ℝ)*(-1 : ℝ)^6*m^5*c^0*q6))))*(-m-c*w)^1+((((1 : ℝ)*(-1 : ℝ)^2*m^0*c^4*q2+(3 : ℝ)*(-1 : ℝ)^3*m^1*c^3*q3)+((6 : ℝ)*(-1 : ℝ)^4*m^2*c^2*q4+((10 : ℝ)*(-1 : ℝ)^5*m^3*c^1*q5+(15 : ℝ)*(-1 : ℝ)^6*m^4*c^0*q6))))*(-m-c*w)^2))+((((((1 : ℝ)*(-1 : ℝ)^3*m^0*c^3*q3+(4 : ℝ)*(-1 : ℝ)^4*m^1*c^2*q4)+((10 : ℝ)*(-1 : ℝ)^5*m^2*c^1*q5+(20 : ℝ)*(-1 : ℝ)^6*m^3*c^0*q6)))*(-m-c*w)^3+(((1 : ℝ)*(-1 : ℝ)^4*m^0*c^2*q4+((5 : ℝ)*(-1 : ℝ)^5*m^1*c^1*q5+(15 : ℝ)*(-1 : ℝ)^6*m^2*c^0*q6)))*(-m-c*w)^4)+((((1 : ℝ)*(-1 : ℝ)^5*m^0*c^1*q5+(6 : ℝ)*(-1 : ℝ)^6*m^1*c^0*q6))*(-m-c*w)^5+((1 : ℝ)*(-1 : ℝ)^6*m^0*c^0*q6)*(-m-c*w)^6))) := by ring

end LeanVerification.PositiveDCompletion
